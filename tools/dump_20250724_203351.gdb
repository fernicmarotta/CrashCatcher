# Show restored state
echo \n=== State restored! ===\n
printf "PC = 0x%08x  ", $pc
x/i $pc
printf "LR = 0x%08x  ", $lr
x/i $lr
printf "SP = 0x%08x\n", $sp

echo \n=== CPU Registers ===\n
